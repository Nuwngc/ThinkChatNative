<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:padding="16dp" android:background="@color/panel" android:layout_marginBottom="1dp" android:layout_width="match_parent" android:layout_height="wrap_content">
